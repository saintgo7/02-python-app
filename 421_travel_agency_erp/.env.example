# Application Configuration
APP_NAME=Travel Agency ERP System
DEBUG=False
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/travel_erp
DATABASE_POOL_SIZE=5
DATABASE_POOL_RECYCLE=3600

# Security - REQUIRED IN PRODUCTION
SECRET_KEY=your-secret-key-here-change-in-production-minimum-32-chars

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# Optional - Redis Cache
REDIS_URL=redis://localhost:6379

# Optional - AWS Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-key-id
AWS_SECRET_ACCESS_KEY=your-secret-key

# Optional - Payment Gateways
STRIPE_API_KEY=sk_test_xxxxx
PAYPAL_CLIENT_ID=xxxxx
PAYPAL_CLIENT_SECRET=xxxxx

# Optional - Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-password
SENDER_EMAIL=noreply@travelagency.com
