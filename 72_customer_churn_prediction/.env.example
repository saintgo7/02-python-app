# Application
APP_NAME={app_name}
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=sqlite:///./test.db

# Redis
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API
API_PORT=8000
API_HOST=0.0.0.0

# CORS
CORS_ORIGINS=["http://localhost:3000"]
